{
  "name": "@mridang/semantic-release-packagist",
  "version": "1.6.2",
  "type": "module",
  "scripts": {
    "prepack": "tsc",
    "build": "tsc",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:watch": "npm run test -- --watch",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "semver",
    "nodejs",
    "semantic-release"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "Semantic Release plugin that prevents major releases unless a corresponding tag exists on a specific branch in an upstream GitHub repository.",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/semantic-release-packagist.git"
  },
  "homepage": "https://github.com/mridang/semantic-release-packagist",
  "bugs": "https://github.com/mridang/semantic-release-packagist/issues",
  "dependencies": {
    "@semantic-release/error": "^4.0.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "file:../../pack/mridang-eslint-defaults-2.0.1.tgz",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.12",
    "@types/semantic-release__error": "^3.0.3",
    "eslint": "^9.39.5",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@eslint/core": "1.2.1"
  }
}
